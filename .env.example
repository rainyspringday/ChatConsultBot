#Paths
INPUT_DIR=data/input_files
OUTPUT_DIR=data/cleaned_files
GRAPH_DIR=data/graph
PROMPT_DIR=src/prompts
CHROMA_DIR=data/chroma
FRAMEWORKS_DIR=data/frameworks
# Model Configuration
MODEL_NAME=llama-3.3-70b-versatile

# Backend workers (run_dev.py). Default 4; set to 1 to enable auto-reload.
# UVICORN_WORKERS=4

# Dev tunneling (optional)
# USE_NGROK=1
# Requires ngrok CLI installed and authenticated:
#   ngrok config add-authtoken <your-token>
# (saved to ~/.config/ngrok/ngrok.yml — run_dev merges that file automatically)
# Or set token here if you prefer:
# NGROK_AUTHTOKEN=your-token-here